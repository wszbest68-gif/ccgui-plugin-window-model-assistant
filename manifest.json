{
  "id": "window-model-assistant",
  "name": "窗口与模型助手",
  "version": "0.1.0",
  "sdkVersion": "^0.3.16",
  "minAppVersion": "1.0.10",
  "author": "wszbest68-gif",
  "description": "仅管理 CC GUI 主窗口的位置与大小，并透明展示宿主公开的服务商模型目录及来源状态。",
  "repo": "wszbest68-gif/ccgui-plugin-window-model-assistant",
  "license": "MIT",
  "keywords": ["window", "models", "catalog", "窗口", "模型"],
  "tier": "js",
  "permissions": [
    "host:window",
    "host:models",
    "storage",
    "ui:panel-tab",
    "ui:settings-section",
    "ui:command",
    "ui:status-bar",
    "i18n"
  ]
}
